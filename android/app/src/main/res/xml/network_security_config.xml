<?xml version="1.0" encoding="utf-8"?>
<!-- Appodeal rehberi: Android 9+ duz HTTP'yi engeller; bazi reklam ag/kreatifleri
     HTTP kullandigi icin reklam gelmeyebilir. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
